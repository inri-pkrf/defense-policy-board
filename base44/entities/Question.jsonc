{
  "name": "Question",
  "type": "object",
  "properties": {
    "level": {
      "type": "integer",
      "enum": [
        100,
        200,
        300,
        400,
        500
      ],
      "title": "\u05e8\u05de\u05ea \u05e7\u05d5\u05e9\u05d9",
      "description": "100=\u05e7\u05dc, 200=\u05d1\u05e1\u05d9\u05e1\u05d9, 300=\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9, 400=\u05de\u05d5\u05e8\u05db\u05d1, 500=\u05de\u05d5\u05de\u05d7\u05d4"
    },
    "type": {
      "type": "string",
      "enum": [
        "true_false",
        "multiple_choice",
        "matching",
        "ordering"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05de\u05e9\u05d9\u05de\u05d4",
      "default": "true_false"
    },
    "question": {
      "type": "string",
      "title": "\u05e9\u05d0\u05dc\u05d4 / \u05de\u05e9\u05d9\u05de\u05d4 / \u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d4\u05e9\u05d0\u05dc\u05d4 \u05d0\u05d5 \u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 \u05d4\u05de\u05d5\u05e6\u05d2 \u05dc\u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d1\u05d7\u05d9\u05e8\u05d4",
      "description": "\u05e2\u05d1\u05d5\u05e8 \u05d1\u05d7\u05d9\u05e8\u05d4 \u05de\u05e8\u05d5\u05d1\u05d4 - \u05e8\u05e9\u05d9\u05de\u05ea \u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d0\u05e4\u05e9\u05e8\u05d9\u05d5\u05ea"
    },
    "correct_answer": {
      "type": "string",
      "title": "\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e0\u05db\u05d5\u05e0\u05d4",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 (\u05d0\u05de\u05ea/\u05e9\u05e7\u05e8, \u05d0\u05d5 \u05d4\u05d8\u05e7\u05e1\u05d8 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05de\u05ea\u05d5\u05da options)"
    },
    "matching_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "title": "\u05de\u05d5\u05e9\u05d2"
          },
          "definition": {
            "type": "string",
            "title": "\u05d4\u05d2\u05d3\u05e8\u05d4"
          }
        }
      },
      "title": "\u05d6\u05d5\u05d2\u05d5\u05ea \u05d4\u05ea\u05d0\u05de\u05d4",
      "description": "\u05e2\u05d1\u05d5\u05e8 \u05de\u05e9\u05d9\u05de\u05ea \u05d4\u05ea\u05d0\u05de\u05d4 - \u05d6\u05d5\u05d2\u05d5\u05ea \u05de\u05d5\u05e9\u05d2-\u05d4\u05d2\u05d3\u05e8\u05d4"
    },
    "ordering_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05dc\u05e1\u05d9\u05d3\u05d5\u05e8",
      "description": "\u05e2\u05d1\u05d5\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8 \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea - \u05d4\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d1\u05e1\u05d3\u05e8 \u05d4\u05e0\u05db\u05d5\u05df"
    },
    "explanation": {
      "type": "string",
      "title": "\u05d4\u05e1\u05d1\u05e8",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05d4\u05de\u05d5\u05e6\u05d2 \u05dc\u05d0\u05d7\u05e8 \u05de\u05e2\u05e0\u05d4"
    },
    "order": {
      "type": "integer",
      "title": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4",
      "default": 0
